# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# A long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Port the server listens on
PORT=3001

# BlueMap base URL — used by the tile proxy (the BlueMap host is plain HTTP,
# so tiles are fetched server-side to avoid mixed-content blocking) and by
# /api/bluemap-config, the auto-detect fallback the map pages use on load.
# Keep this in sync with ballistics/assets/shells.json's "bluemapBaseUrl" and
# land-registry/assets/mapconfig.json.
BLUEMAP_BASE_URL=http://regnumaeternum.enderman.cloud:50500
