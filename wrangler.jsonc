{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "regnumaeternum",
	"main": "worker/index.js",
	"compatibility_date": "2026-06-19",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "regnum-aeternum",
		"binding": "ASSETS"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BLUEMAP_BASE_URL": "http://regnumaeternum.enderman.cloud:50500"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "regnum-aeternum-db",
			"database_id": "26aa5fb2-a699-4b3c-abbc-32d35cf70c72"
		}
	],
	"triggers": {
		// Every minute drives the scheduled attack plans (worker/lib/attack-scheduler.js):
		// it launches any plan whose moment has come and keeps every launched plan's
		// shot queue topped up, so an attack fires with no calculator page open. The
		// rest are the market, banking and settlement timers.
		"crons": ["* * * * *", "*/5 * * * *", "0 * * * *", "0 20 * * *", "0 8 * * *"]
	}
}